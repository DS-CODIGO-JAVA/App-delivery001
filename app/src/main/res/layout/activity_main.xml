<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <ImageView android:id="@+id/logo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/logo"
            android:layout_gravity="center"
            android:layout_marginTop="30dp" />

        <EditText android:id="@+id/email"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:hint="Email"
            android:padding="15dp"
            android:background="@drawable/borda"/>

        <EditText android:id="@+id/senha"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberPassword"
            android:hint="Senha"
            android:padding="15dp"
            android:maxLines="1"
            android:background="@drawable/borda"
            />

        <TextView android:id="@+id/mensagem_erro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preencha todos os campos"
            android:textColor="@color/red"
            android:visibility="invisible"
            android:layout_marginStart="25dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/botao_entrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:backgroundTint="@color/red_dark"
            android:padding="15dp"
            android:text="ENTRAR"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView android:id="@+id/criar_conta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crie a sua conta clicando aqui."
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="20dp" />

        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="25dp"
            android:visibility="invisible"
            android:indeterminateTint="@color/red_dark"
            />




    </LinearLayout>
</androidx.core.widget.NestedScrollView>